# Virtual environments
.venv/
venv/
ENV/
env/

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# OS artifacts
.DS_Store
Thumbs.db

# Environment variables & secrets
.env
*.env

# Data artifacts (track jsonl, json, and tsv files; ignore raw multi-gigabyte archives)
*.zip
*.tar.gz
*.parquet
*.parquet.tmp
data/**/*.zip
data/**/*.tar.gz
data/**/*.parquet
data/**/*.parquet.tmp
data/**/*.tmp
!data/nq_subset/*.jsonl
!data/nq_subset/*.json
!data/nq_subset/*.tsv
!data/nq_subset/.gitkeep
!data/poisoned_datasets/*.jsonl
!data/poisoned_datasets/*.json
!data/poisoned_datasets/.gitkeep

# IDE and editor settings
.vscode/
.idea/
*.swp
*.swo

# Output / logs / runs
logs/
outputs/
*.log
